PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trainingslager
ADMIN_API_KEY=replace-with-a-long-random-key

# EMAIL — every form application is emailed to ADMIN_EMAIL (several addresses: separate with commas).
# The applicant also gets a confirmation copy. Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-character Google "App password">, SMTP_FROM="Antalya Camp <you@gmail.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=

# Public SEO and analytics configuration.
PUBLIC_SITE_URL=https://trainingslager-antalya.de
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Optional: WhatsApp business number (digits only, with country code). Enables the WhatsApp button on mobile.
WHATSAPP_NUMBER=
# Number of reverse proxies in front of the app (Render, nginx…). Use 0 when running without a proxy.
TRUST_PROXY_HOPS=1
